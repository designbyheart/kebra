# Git feeds one line per pushed ref on stdin:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# Skip the expensive checks when nothing new is going out: every ref either
# already matches the remote or is only being deleted (all-zero local sha).
has_new_commits=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # ref deletion
  [ "$local_sha" = "$remote_sha" ] && continue          # already on the remote
  has_new_commits=1
done

if [ "$has_new_commits" -eq 0 ]; then
  echo "pre-push: no new commits to push, skipping tests and build."
  exit 0
fi

pnpm run test
pnpm run build
